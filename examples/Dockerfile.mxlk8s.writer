# SPDX-License-Identifier: Apache-2.0
#
# mxl-writer image that reuses jonasohland's prebuilt libmxl so the binary
# ABI matches the mxl-k8s gateway (which runs FROM the same image). This
# is the simpler, guaranteed-compatible variant of the earlier from-source
# attempt: no compiler-flag, no vcpkg-version, no libfabric-build drift —
# the writer loads the exact same .so the gateway does.
#
# jonasohland/mxl:3518992-fabrics-efa ships:
#   - libmxl.so + libmxl-fabrics.so (built from dmf-mxl/mxl @ 3518992 +
#     Jonas's read-only-mmap patch, see dmf-mxl/mxl#516)
#   - libfabric 2.4 with the EFA provider (Amazon EFA installer's .debs)
#   - the upstream tools/ binaries: mxl-gst-testsrc, mxl-info, etc.
#
# All we add on top is GStreamer's plugins and the NMOS flow JSON template
# that mxl-gst-testsrc reads.

FROM jonasohland/mxl:3518992-fabrics-efa

USER 0:0

# decodebin / playbin chain for v210 production + the libav decoder family.
RUN apt-get update && apt-get install -y --no-install-recommends \
        gstreamer1.0-x \
        gstreamer1.0-plugins-good \
        gstreamer1.0-plugins-base \
        gstreamer1.0-plugins-bad \
        gstreamer1.0-plugins-ugly \
        gstreamer1.0-libav \
    && rm -rf /var/lib/apt/lists/*

# v210 video + audio flow JSON templates. Pulled from the upstream test
# data tree because that's the same schema mxl-k8s expects.
COPY lib/tests/data/v210_flow.json /home/mxl/v210_flow.json
COPY lib/tests/data/audio_flow.json /home/mxl/audio_flow.json
RUN chown -R mxl:mxl /home/mxl

USER mxl
WORKDIR /home/mxl

ENTRYPOINT []
CMD ["/usr/bin/mxl-gst-testsrc", "-d", "/run/mxl/domain", "-v", "/home/mxl/v210_flow.json"]
