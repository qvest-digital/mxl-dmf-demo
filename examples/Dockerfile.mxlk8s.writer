#
# mxl-writer image that pins libmxl + libfabric to the same canonical
# qvest-digital build the mxl-k8s gateway loads, so the writer's flow
# files round-trip through the gateway without ABI mismatch.
#
# Base: ghcr.io/qvest-digital/go-mxl-runtime:1.0.0-rc.5
#   The go-mxl release pipeline (qvest-digital/go-mxl#47, #49) builds
#   libfabric + rdma-core from upstream with the flag set that
#   maximises provider coverage (efa, verbs, tcp, ...) and ships them
#   alongside libmxl + libmxl-fabrics under /usr/lib. mxl-k8s gateway
#   (docker/gateway.Dockerfile) consumes the matching builder image,
#   so writer + gateway end up with byte-identical libmxl.so.
#
# Tag bump policy: keep this in sync with mxl-k8s gateway's
# ARG GO_MXL_TAG, currently 1.0.0-rc.5.

FROM ghcr.io/qvest-digital/go-mxl-runtime:1.0.0-rc.5

USER 0:0

# decodebin / playbin chain for v210 production + the libav decoder family.
RUN apt-get update && apt-get install -y --no-install-recommends \
        gstreamer1.0-x \
        gstreamer1.0-plugins-good \
        gstreamer1.0-plugins-base \
        gstreamer1.0-plugins-bad \
        gstreamer1.0-plugins-ugly \
        gstreamer1.0-libav \
    && rm -rf /var/lib/apt/lists/*

# v210 video + audio flow JSON templates. Pulled from the upstream test
# data tree because that's the same schema mxl-k8s expects.
COPY lib/tests/data/v210_flow.json /home/mxl/v210_flow.json
COPY lib/tests/data/audio_flow.json /home/mxl/audio_flow.json
RUN chown -R mxl:mxl /home/mxl || true

USER mxl
WORKDIR /home/mxl

ENTRYPOINT []
CMD ["/usr/bin/mxl-gst-testsrc", "-d", "/run/mxl/domain", "-v", "/home/mxl/v210_flow.json"]
