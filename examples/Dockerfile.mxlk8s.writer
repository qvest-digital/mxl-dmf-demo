#
# mxl-writer for mxl-k8s. Bases on jonasohland/mxl:3518992-fabrics-efa
# because that image ships the upstream tools/ binaries (mxl-gst-testsrc,
# mxl-info, ...) we need to produce flows. Note: the *canonical*
# qvest-digital base is ghcr.io/qvest-digital/go-mxl-runtime — the
# mxl-k8s gateway uses that for its libmxl + libfabric runtime, and it
# is the long-term target for both writer and compositor (see review on
# qvest-digital/mxl-dmf-demo-app#2). go-mxl-runtime ships libs only,
# though, so until tools/mxl-gst-testsrc is built into the same image
# (or compiled here in a builder stage) we stay on jonasohland to keep
# the producer-side test pattern working.
#
# Empirically the jonasohland libmxl is ABI-compatible with the
# go-mxl-runtime libmxl the gateway loads — first MxlFlowMirror went
# Ready end-to-end on the PR cluster, so the on-disk flow header layout
# matches across the two.

FROM jonasohland/mxl:3518992-fabrics-efa

USER 0:0

# decodebin / playbin chain for v210 production + the libav decoder family.
RUN apt-get update && apt-get install -y --no-install-recommends \
        gstreamer1.0-x \
        gstreamer1.0-plugins-good \
        gstreamer1.0-plugins-base \
        gstreamer1.0-plugins-bad \
        gstreamer1.0-plugins-ugly \
        gstreamer1.0-libav \
    && rm -rf /var/lib/apt/lists/*

# v210 video + audio flow JSON templates. Pulled from the upstream test
# data tree because that's the same schema mxl-k8s expects.
COPY lib/tests/data/v210_flow.json /home/mxl/v210_flow.json
COPY lib/tests/data/audio_flow.json /home/mxl/audio_flow.json
RUN chown -R mxl:mxl /home/mxl

USER mxl
WORKDIR /home/mxl

ENTRYPOINT []
CMD ["/usr/bin/mxl-gst-testsrc", "-d", "/run/mxl/domain", "-v", "/home/mxl/v210_flow.json"]
